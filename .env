# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=public
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://postgres:5432/public

# PgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Axelor Application Configuration
AXELOR_PORT=7070
JAVA_OPTS=-Xms1024m -Xmx2048m

# Docker Images Versions
POSTGRES_IMAGE=postgres:15
PGADMIN_IMAGE=dpage/pgadmin4:latest

# Build Configuration
GRADLE_VERSION=7.6
AXELOR_REPO=https://github.com/axelor/open-suite-webapp.git
AXELOR_VERSION=8.0

# Axelor Database Configuration
AXELOR_DB_URL=jdbc:postgresql://postgres:5432/public
AXELOR_DB_USER=postgres
AXELOR_DB_PASSWORD=admin

# Data Directories (can be customized for different environments)
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/export
INDEXES_DIR=./data/indexes